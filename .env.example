NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXTAUTH_SECRET=troque-por-string-aleatoria-segura
NEXTAUTH_URL=http://localhost:3000
ENABLE_AUTH=false
DISABLE_AUTH=true
# NextAuth precisa confiar no host quando estiver atrás de domínio/proxy conhecido.
# Em produção, mantenha true apenas se o provedor validar o domínio recebido.
AUTH_TRUST_HOST=true
ADMIN_EMAIL=admin@ptmanager.com
ADMIN_NAME="Administrador PT Manager"
# Defina somente no ambiente local/produção antes de rodar npm run admin:create; nunca commite senha real.
ADMIN_PASSWORD=
GEMINI_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CRON_SECRET=troque-por-string-aleatoria
# Webhook do Jotform - defina um segredo para autenticar requisições
JOTFORM_WEBHOOK_SECRET=
